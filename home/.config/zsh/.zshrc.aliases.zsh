alias ls='ls --color=auto'
alias l="ls -l"
alias ll='ls -lA'
alias grep='grep --color=auto'
alias vi='nvim'
alias bc='bc -l'
# Most servers does not recognize "foot" terminal
alias ssh='TERM=xterm-256color ssh'
alias uuidgen-lower="uuidgen | tr '[:upper:]' '[:lower:]'"
